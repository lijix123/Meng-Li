{
    "load_mode": {
        "description": "自动注入模式",
        "type": "string",
        "hint": "选择何时自动读取并注入记忆文件",
        "options": [
            "on_new_session",
            "on_reset"
        ],
        "default": "on_new_session"
    },
    "inject_rounds": {
        "description": "注入成功后即停止（兼容保留）",
        "type": "int",
        "hint": "已废弃：现在注入成功一次后该会话即不再运行本插件，无需设置轮次。保留字段仅为兼容旧配置。",
        "default": 1
    },
    "private_whitelist": {
        "description": "私聊白名单",
        "type": "object",
        "hint": "私聊场景下，允许加载记忆的用户名单",
        "items": {
            "private_whitelist_enabled": {
                "description": "启用私聊白名单",
                "type": "bool",
                "hint": "开启后，仅在下方名单内的私聊用户可加载记忆",
                "default": true
            },
            "private_whitelist_users": {
                "description": "私聊白名单用户QQ号",
                "type": "list",
                "hint": "填写允许生效的私聊用户QQ号，每行一个",
                "default": [
                    "<姐姐UID>"
                ]
            }
        }
    },
    "private_files": {
        "description": "私聊文件",
        "type": "object",
        "hint": "私聊场景下读取的记忆文件",
        "items": {
            "private_memory_file_paths": {
                "description": "私聊记忆文件路径",
                "type": "list",
                "hint": "填写私聊场景要读取的记忆文件完整路径，每行一个",
                "default": [
                    "<工作目录>/_FriendMessage_<姐姐UID>/梦璃记忆.txt"
                ]
            }
        }
    },
    "group_rules": {
        "description": "群聊白名单与文件",
        "type": "template_list",
        "hint": "每个群一条配置：填群号与该群允许读取的记忆文件，可点击 + 新增、删除，实现各群记忆文件互相隔离。不配置任何条目则群聊不加载记忆。",
        "templates": {
            "group": {
                "name": "群配置",
                "hint": "为指定群配置允许读取的记忆文件",
                "items": {
                    "group_id": {
                        "description": "群号",
                        "type": "string",
                        "hint": "填写QQ群号",
                        "default": ""
                    },
                    "group_memory_file_paths": {
                        "description": "该群记忆文件路径",
                        "type": "list",
                        "hint": "该群允许读取的记忆文件完整路径，每行一个",
                        "default": []
                    }
                }
            }
        },
        "default": []
    }
}