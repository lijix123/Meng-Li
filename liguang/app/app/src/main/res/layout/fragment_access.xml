<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- 无障碍服务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无障碍服务"
                android:textColor="@color/liguang_star"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAccessStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="当前：未开启"
                android:textColor="@color/liguang_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="用于清后台、未来的远程手势控制。开启后当前不做任何操作，也不读取你的任何内容。"
                android:textColor="@color/liguang_sub"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnAccessGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/liguang_ribbon"
                android:text="去开启无障碍服务"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- 修改系统设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="修改系统设置"
                android:textColor="@color/liguang_star"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWriteStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="当前：未授权"
                android:textColor="@color/liguang_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="用于远程调节屏幕亮度。"
                android:textColor="@color/liguang_sub"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnWriteGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/liguang_ribbon"
                android:text="去授权修改系统设置"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- 使用情况访问 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用情况访问"
                android:textColor="@color/liguang_star"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsageStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="当前：未授权"
                android:textColor="@color/liguang_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="用于读取最近使用过的应用（只读应用名和使用时间，不读取任何内容）。"
                android:textColor="@color/liguang_sub"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnUsageGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/liguang_ribbon"
                android:text="去授权使用情况访问"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- 系统免打扰权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统免打扰权限"
                android:textColor="@color/liguang_star"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDndStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="当前：未授权"
                android:textColor="@color/liguang_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="用于梦璃远程开启/关闭系统级免打扰（请勿打扰），可静默通知与来电。"
                android:textColor="@color/liguang_sub"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnDndGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/liguang_ribbon"
                android:text="去授权勿扰权限"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
